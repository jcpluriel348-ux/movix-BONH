<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CinéStream - Regarder vos Films, Séries & Animés</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #111; color: white; padding-bottom: 50px; }
        
        /* Barre de navigation */
        header { display: flex; justify-content: space-between; align-items: center; padding: 20px 5%; background-color: #000; position: sticky; top: 0; z-index: 100; border-bottom: 2px solid #e50914; }
        .logo { color: #e50914; font-size: 28px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
        .search-bar { padding: 8px 15px; border-radius: 20px; border: none; background: #222; color: white; width: 250px; outline: none; transition: 0.3s; }
        .search-bar:focus { background: #333; box-shadow: 0 0 5px #e50914; }

        /* Filtres de catégories */
        .tabs { display: flex; justify-content: center; gap: 20px; margin: 30px 0; }
        .tab-btn { background: #222; color: white; border: none; padding: 10px 25px; font-size: 16px; font-weight: 600; cursor: pointer; border-radius: 5px; transition: 0.3s; }
        .tab-btn.active, .tab-btn:hover { background: #e50914; }

        /* Grille des vidéos */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 30px; }
        
        /* Carte de média */
        .card { background: #1c1c1c; border-radius: 8px; overflow: hidden; transition: transform 0.3s, box-shadow: 0.3s; cursor: pointer; position: relative; }
        .card:hover { transform: scale(1.05); box-shadow: 0 10px 20px rgba(229, 9, 20, 0.3); }
        .card img { width: 100%; height: 320px; object-fit: cover; background-color: #333; }
        .card-info { padding: 15px; }
        .card-title { font-size: 16px; font-weight: bold; margin-bottom: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .card-meta { display: flex; justify-content: space-between; font-size: 12px; color: #aaa; }
        .badge { background: #333; padding: 2px 6px; border-radius: 3px; text-transform: uppercase; font-size: 10px; font-weight: bold; color: #fff; }
        .badge.film { background: #007bff; }
        .badge.serie { background: #28a745; }
        .badge.anime { background: #ffc107; color: black; }

        /* Lecteur Modal (Pop-up) */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; justify-content: center; align-items: center; }
        .modal-content { width: 90%; max-width: 800px; background: #111; border-radius: 8px; overflow: hidden; position: relative; }
        .close-btn { position: absolute; top: 15px; right: 20px; font-size: 30px; color: white; cursor: pointer; z-index: 1010; }
        .video-container { position: relative; padding-bottom: 56.25%; height: 0; }
        .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
        .modal-info { padding: 20px; }
    </style>
</head>
<body>

    <header>
        <div class="logo">CinéStream</div>
        <input type="text" id="search" class="search-bar" placeholder="Rechercher un titre...">
    </header>

    <div class="container">
        <!-- Onglets de filtrage -->
        <div class="tabs">
            <button class="tab-btn active" onclick="filterCategory('all')">Tout</button>
            <button class="tab-btn" onclick="filterCategory('film')">Films</button>
            <button class="tab-btn" onclick="filterCategory('serie')">Séries</button>
            <button class="tab-btn" onclick="filterCategory('anime')">Animés</button>
        </div>

        <!-- Catalogue -->
        <div class="grid" id="catalog"></div>
    </div>

    <!-- Fenêtre Pop-up du Lecteur Vidéo -->
    <div class="modal" id="videoModal">
        <span class="close-btn" onclick="closeModal()">&times;</span>
        <div class="modal-content">
            <div class="video-container">
                <iframe id="videoPlayer" src="" allowfullscreen></iframe>
            </div>
            <div class="modal-info">
                <h2 id="modalTitle">Titre de la vidéo</h2>
                <p id="modalDesc" style="color: #aaa; margin-top: 10px; font-size: 14px;"></p>
            </div>
        </div>
    </div>

    <script>
        // Base de données des œuvres connues (Tu peux en ajouter autant que tu veux !)
        const mediaData = [
            // FILMS
            { title: "Avatar: La Voie de l'Eau", type: "film", year: "2022", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Jake Sully et Ney'tiri ont formé une famille et font tout pour rester aussi unis que possible." },
            { title: "Inception", type: "film", year: "2010", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Un voleur expérimenté s'approprie les secrets les plus précieux d'un individu pendant qu'il rêve." },
            { title: "Interstellar", type: "film", year: "2014", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Un groupe d'explorateurs voyage au-delà de notre galaxie pour savoir si l'homme peut vivre sur une autre planète." },
            
            // SÉRIES
            { title: "Stranger Things", type: "serie", year: "Saison 4", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Quand un jeune garçon disparaît, une petite ville découvre un mystère entourant des expériences secrètes." },
            { title: "Breaking Bad", type: "serie", year: "5 Saisons", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Un professeur de chimie de lycée atteint d'un cancer se tourne cordialement vers la fabrication de méthamphétamine." },
            { title: "Mercredi", type: "serie", year: "Saison 1", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Brillante et sarcastique, Mercredi Addams enquête sur une série de crimes au sein de la Nevermore Academy." },

            // ANIMÉS
            { title: "Demon Slayer", type: "anime", year: "Saison 4", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Tanjiro part en quête pour soigner sa sœur Nezuko, transformée en démon, et venger sa famille." },
            { title: "One Piece", type: "anime", year: "1000+ Ep", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Luffy et son équipage naviguent sur les mers à la recherche du trésor légendaire, le One Piece." },
            { title: "L'Attaque des Titans", type: "anime", year: "Final", image: "https://unsplash.com", videoUrl: "https://youtube.com", desc: "Dans un monde ravagé par des titans mangeurs d'hommes, Eren Jäger jure de tous les exterminer." Enseigné." }
        ];

        let currentCategory = 'all';

        // Générer les cartes dans la page
        function displayMedia(data) {
            const catalog = document.getElementById('catalog');
            catalog.innerHTML = '';
            
            data.forEach(item => {
                const card = document.createElement('div');
                card.className = 'card';
                card.onclick = () => openModal(item);
                
                card.innerHTML = `
                    <img src="${item.image}" alt="${item.title}">
                    <div class="card-info">
                        <div class="card-title">${item.title}</div>
                        <div class="card-meta">
                            <span>${item.year}</span>
                            <span class="badge ${item.type}">${item.type}</span>
                        </div>
                    </div>
                `;
                catalog.appendChild(card);
            });
        }

        // Filtrer par onglet
        function filterCategory(category) {
            currentCategory = category;
            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            applyFilters();
        }

        // Appliquer la recherche et les onglets en même temps
        function applyFilters() {
            const searchWord = document.getElementById('search').value.toLowerCase();
            const filtered = mediaData.filter(item => {
                const matchesCategory = (currentCategory === 'all' || item.type === currentCategory);
                const matchesSearch = item.title.toLowerCase().includes(searchWord);
                return matchesCategory && matchesSearch;
            });
            displayMedia(filtered);
        }

        // Écouteur de recherche
        document.getElementById('search').addEventListener('input', applyFilters);

        // Fonctions du Lecteur Modal
        function openModal(item) {
            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalDesc').innerText = item.desc;
            document.getElementById('videoPlayer').src = item.videoUrl;
